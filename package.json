    "./keyring": "./keyring.js",
    "./visitEnvelope": "./visitEnvelope.js",
    "./longitudinalLogic": "./longitudinalLogic.js",
    "./package.json": "./package.json"
  },
  "files": [
    "envelope.js",
    "keyring.js",
    "visitEnvelope.js",
    "longitudinalLogic.js",
    "demo.mjs",
    "keyring.mjs",
    "longitudinal.mjs",
    "roundtrip.mjs",
    "verify-kit.mjs",
    "KIT-MANIFEST.txt",
    "LICENSE",
    "README.md"
